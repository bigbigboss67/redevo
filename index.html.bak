<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AETHEL APEX // I LOVE BOSNIA — $1,000,000 Sovereign Enterprise PM OS</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://unpkg.com/lucide@latest"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', 'sans-serif'],
            mono: ['"JetBrains Mono"', 'monospace'],
          },
          colors: {
            brand: {
              gold: '#E5A93C',
              'gold-light': '#F7D070',
              'gold-dim': 'rgba(229, 169, 60, 0.15)',
              obsidian: '#07080B',
              surface: '#0F1117',
              'surface-card': '#151822',
              border: 'rgba(255, 255, 255, 0.08)',
              emerald: '#10B981',
              rose: '#F43F5E',
              amber: '#F59E0B',
              cyan: '#06B6D4'
            }
          }
        }
      }
    }
  </script>
  <style>
    body {
      background-color: #07080B;
      color: #E2E8F0;
      font-family: 'Plus Jakarta Sans', sans-serif;
      overflow-x: hidden;
    }
    .double-bezel {
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 1.75rem;
      padding: 0.375rem;
      box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.7);
    }
    .inner-core {
      background: #0F1117;
      border: 1px solid rgba(255, 255, 255, 0.05);
      border-radius: calc(1.75rem - 0.375rem);
      box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.12);
    }
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #07080B;
    }
    ::-webkit-scrollbar-thumb {
      background: rgba(255, 255, 255, 0.15);
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #E5A93C;
    }
    .pulsing-beacon {
      box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7);
      animation: pulse-ring 2s cubic-bezier(0.45, 0, 0.2, 1) infinite;
    }
    @keyframes pulse-ring {
      0% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); }
      70% { box-shadow: 0 0 0 10px rgba(16, 185, 129, 0); }
      100% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
    }
  </style>
</head>
<body class="min-h-[100dvh] flex flex-col antialiased selection:bg-[#E5A93C]/30 selection:text-white">

  <!-- Ambient Glow -->
  <div class="fixed top-0 left-1/2 -translate-x-1/2 w-[1100px] h-[320px] bg-gradient-to-b from-[#E5A93C]/10 via-[#06B6D4]/5 to-transparent blur-3xl pointer-events-none -z-10"></div>

  <!-- Main View Container -->
  <div class="w-full max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-8 py-5 space-y-6">

    <!-- FLOATING TOP COMMAND BAR -->
    <header class="double-bezel sticky top-4 z-40">
      <div class="inner-core px-6 py-3.5 flex flex-col xl:flex-row items-center justify-between gap-4">
        
        <div class="flex items-center gap-4">
          <div class="w-11 h-11 rounded-2xl bg-gradient-to-br from-[#E5A93C] to-[#996515] p-[1px] shadow-lg shadow-[#E5A93C]/10">
            <div class="w-full h-full bg-[#07080B] rounded-[calc(1rem-1px)] flex items-center justify-center">
              <i data-lucide="layers" class="w-5 h-5 text-[#E5A93C]"></i>
            </div>
          </div>
          <div>
            <div class="flex items-center gap-2">
              <span class="text-xs uppercase tracking-[0.25em] font-mono text-[#E5A93C] font-semibold">AETHEL APEX // 100% SOVEREIGN INTERNAL OS</span>
              <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-[10px] font-mono text-emerald-400">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-ping"></span> I LOVE BOSNIA (BREZA)
              </span>
            </div>
            <h1 class="text-lg font-bold text-white tracking-tight flex items-center gap-2">
              120 Luxury Villas Master Development <span class="text-slate-500 font-light">|</span> 124,480 m² <span class="text-xs font-mono px-2 py-0.5 rounded bg-white/5 text-slate-300">Sarajevo North</span>
            </h1>
          </div>
        </div>

        <!-- Master Tabs -->
        <div class="flex items-center p-1 bg-black/50 rounded-full border border-white/5 text-xs font-medium overflow-x-auto max-w-full">
          <button onclick="switchTab('cockpit')" id="tab-btn-cockpit" class="nav-tab px-3.5 py-1.5 rounded-full bg-white/10 text-white font-semibold transition whitespace-nowrap">
            1. Cockpit
          </button>
          <button onclick="switchTab('matrix')" id="tab-btn-matrix" class="nav-tab px-3.5 py-1.5 rounded-full text-slate-400 hover:text-white transition whitespace-nowrap">
            2. 120-Plot CAD Matrix
          </button>
          <button onclick="switchTab('digital-twin')" id="tab-btn-digital-twin" class="nav-tab px-3.5 py-1.5 rounded-full text-slate-400 hover:text-white transition whitespace-nowrap">
            3. 3D BIM & Drone LiDAR
          </button>
          <button onclick="switchTab('escrow')" id="tab-btn-escrow" class="nav-tab px-3.5 py-1.5 rounded-full text-slate-400 hover:text-white transition whitespace-nowrap">
            4. FIDIC Escrow Multi-Sig
          </button>
          <button onclick="switchTab('contractor-sla')" id="tab-btn-contractor-sla" class="nav-tab px-3.5 py-1.5 rounded-full text-slate-400 hover:text-white transition whitespace-nowrap">
            5. Biometrics & Penalties
          </button>
          <button onclick="switchTab('fidic-claims')" id="tab-btn-fidic-claims" class="nav-tab px-3.5 py-1.5 rounded-full text-slate-400 hover:text-white transition whitespace-nowrap">
            6. FIDIC Clause 20 Claims
          </button>
          <button onclick="switchTab('bizdev-engine')" id="tab-btn-bizdev-engine" class="nav-tab px-3.5 py-1.5 rounded-full text-[#E5A93C] bg-[#E5A93C]/10 border border-[#E5A93C]/30 font-semibold hover:text-white transition whitespace-nowrap">
            ✦ Ingestion & BizDev OS
          </button>
          <button onclick="switchTab('buyer-portal')" id="tab-btn-buyer-portal" class="nav-tab px-3.5 py-1.5 rounded-full text-slate-400 hover:text-white transition whitespace-nowrap">
            8. Buyer 360° Portal
          </button>
        </div>

        <div class="flex items-center gap-3">
          <div class="flex items-center bg-black/60 border border-white/10 rounded-full p-1 text-[11px] font-mono">
            <button onclick="setCurrency('EUR')" id="curr-EUR" class="curr-btn px-2.5 py-1 rounded-full bg-[#E5A93C] text-black font-bold">EUR €</button>
            <button onclick="setCurrency('BAM')" id="curr-BAM" class="curr-btn px-2.5 py-1 rounded-full text-slate-400 hover:text-white">BAM KM</button>
            <button onclick="setCurrency('USD')" id="curr-USD" class="curr-btn px-2.5 py-1 rounded-full text-slate-400 hover:text-white">USD $</button>
            <button onclick="setCurrency('AED')" id="curr-AED" class="curr-btn px-2.5 py-1 rounded-full text-slate-400 hover:text-white">AED</button>
          </div>

          <button onclick="triggerSimulationModal()" class="group relative inline-flex items-center gap-2 pl-3.5 pr-1.5 py-1.5 rounded-full bg-white/5 border border-white/15 hover:border-[#E5A93C]/50 transition text-xs font-semibold text-white">
            <span>Risk Simulator</span>
            <div class="w-6 h-6 rounded-full bg-[#E5A93C] flex items-center justify-center text-black group-hover:rotate-45 transition-transform">
              <i data-lucide="zap" class="w-3 h-3"></i>
            </div>
          </button>
        </div>
      </div>
    </header>

    <!-- PILLAR 1: COCKPIT -->
    <main id="view-cockpit" class="tab-view space-y-6">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
        <div class="double-bezel">
          <div class="inner-core p-5 flex flex-col justify-between h-full space-y-3">
            <span class="text-[11px] font-mono uppercase tracking-wider text-slate-400">Total Project GDV</span>
            <div>
              <div class="text-2xl font-bold font-mono tracking-tight text-white" id="kpi-gdv">€54,200,000</div>
              <p class="text-xs text-slate-400 mt-1"><span class="text-emerald-400 font-mono">↑ 50/50 Schedule</span> Escrow drawdown 68.4%</p>
            </div>
            <div class="w-full bg-white/5 rounded-full h-1.5 overflow-hidden">
              <div class="bg-gradient-to-r from-[#E5A93C] to-emerald-400 h-full rounded-full" style="width: 68.4%"></div>
            </div>
            <div class="flex justify-between text-[10px] font-mono text-slate-400">
              <span>Paid: <strong class="text-white" id="kpi-paid">€37.07M</strong></span>
              <span>In Escrow: <strong class="text-white" id="kpi-escrow">€17.13M</strong></span>
            </div>
          </div>
        </div>

        <div class="double-bezel">
          <div class="inner-core p-5 flex flex-col justify-between h-full space-y-3">
            <span class="text-[11px] font-mono uppercase tracking-wider text-slate-400">Schedule Float Buffer</span>
            <div>
              <div class="text-2xl font-bold font-mono tracking-tight text-white">64.2% <span class="text-xs font-normal text-slate-400">(Target: 68.0%)</span></div>
              <p class="text-xs text-slate-400 mt-1">Superstructure core ahead of target</p>
            </div>
            <div class="w-full bg-white/5 rounded-full h-1.5 overflow-hidden">
              <div class="bg-emerald-400 h-full" style="width: 64.2%"></div>
            </div>
            <div class="flex justify-between text-[10px] font-mono text-slate-400">
              <span>Critical Path: <strong class="text-emerald-400">OPTIMAL (+11.4d)</strong></span>
              <span>Handover: Q2 2027</span>
            </div>
          </div>
        </div>

        <div class="double-bezel">
          <div class="inner-core p-5 flex flex-col justify-between h-full space-y-3">
            <span class="text-[11px] font-mono uppercase tracking-wider text-slate-400">Turnstile Biometrics (Ulaz 1-7)</span>
            <div>
              <div class="text-2xl font-bold font-mono tracking-tight text-white">142 <span class="text-xs font-normal text-slate-400 font-sans">Active Craftsmen</span></div>
              <p class="text-xs text-slate-400 mt-1">48 Rebar, 34 Concrete, 28 MEP, 12 QA</p>
            </div>
            <div class="flex items-center gap-2 text-[11px] font-mono text-slate-400">
              <span class="w-2 h-2 rounded-full bg-emerald-400 pulsing-beacon"></span>
              <span>412 Days Zero Lost-Time Incidents</span>
            </div>
            <div class="flex justify-between text-[10px] font-mono text-slate-400">
              <span>Weather: <strong class="text-white">12°C Clear, Breza Valley</strong></span>
              <span>Wind: 8 km/h</span>
            </div>
          </div>
        </div>

        <div class="double-bezel">
          <div class="inner-core p-5 flex flex-col justify-between h-full space-y-3">
            <span class="text-[11px] font-mono uppercase tracking-wider text-slate-400">FIDIC QA Pass Rate</span>
            <div>
              <div class="text-2xl font-bold font-mono tracking-tight text-white">€0 <span class="text-xs font-normal text-slate-400 font-sans">Active Penalties</span></div>
              <p class="text-xs text-slate-400 mt-1">Avg contractor snag fix: 18.4 hrs (SLA: 24h)</p>
            </div>
            <div class="w-full bg-white/5 rounded-full h-1.5 overflow-hidden">
              <div class="bg-emerald-400 h-full" style="width: 98.2%"></div>
            </div>
            <div class="flex justify-between text-[10px] font-mono text-slate-400">
              <span>Sinteza CAD Audit: <strong class="text-white">Active</strong></span>
              <span>120 Plots Checked</span>
            </div>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        <div class="lg:col-span-8 double-bezel">
          <div class="inner-core p-6 space-y-6">
            <div class="flex justify-between items-center pb-4 border-b border-white/5">
              <div>
                <span class="text-[10px] font-mono uppercase tracking-[0.2em] text-[#E5A93C]">Master Plan Zoning & Progress</span>
                <h2 class="text-lg font-bold text-white tracking-tight">120 Luxury 4-Bedroom Villas (300 m² BUA Each)</h2>
              </div>
              <button onclick="switchTab('matrix')" class="px-3.5 py-1.5 rounded-full bg-white/5 hover:bg-white/10 text-xs font-mono text-[#E5A93C] border border-[#E5A93C]/30 flex items-center gap-1.5 transition">
                <i data-lucide="grid" class="w-3.5 h-3.5"></i> Inspect 120 Plots
              </button>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
              <div class="relative group rounded-2xl overflow-hidden border border-white/10 bg-black aspect-[4/3]">
                <img src="assets/images/villa_facade_exterior.jpg" alt="Villa Exterior" class="w-full h-full object-cover group-hover:scale-105 transition duration-500">
                <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent flex flex-col justify-end p-3">
                  <span class="text-[10px] font-mono text-[#E5A93C] font-semibold">CLUSTER ALPHA (K01 - K30)</span>
                  <p class="text-xs font-bold text-white">Signature Contemporary Villas</p>
                  <span class="text-[10px] text-emerald-400 font-mono mt-0.5">85% Complete (Fitout)</span>
                </div>
              </div>

              <div class="relative group rounded-2xl overflow-hidden border border-white/10 bg-black aspect-[4/3]">
                <img src="assets/images/villa_facade_dusk.jpg" alt="Villa Dusk" class="w-full h-full object-cover group-hover:scale-105 transition duration-500">
                <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent flex flex-col justify-end p-3">
                  <span class="text-[10px] font-mono text-[#E5A93C] font-semibold">CLUSTER BETA (K31 - K75)</span>
                  <p class="text-xs font-bold text-white">Hillside Panoramic Villas</p>
                  <span class="text-[10px] text-cyan-400 font-mono mt-0.5">62% Superstructure Core</span>
                </div>
              </div>

              <div class="relative group rounded-2xl overflow-hidden border border-white/10 bg-black aspect-[4/3]">
                <img src="assets/images/villa_rear_garden_pool.jpg" alt="Rear Garden Pool" class="w-full h-full object-cover group-hover:scale-105 transition duration-500">
                <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent flex flex-col justify-end p-3">
                  <span class="text-[10px] font-mono text-[#E5A93C] font-semibold">CLUSTER GAMMA (K76 - K120)</span>
                  <p class="text-xs font-bold text-white">Valley Garden Estates</p>
                  <span class="text-[10px] text-amber-400 font-mono mt-0.5">48% Ground Foundations</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="lg:col-span-4 double-bezel">
          <div class="inner-core p-6 space-y-4 flex flex-col justify-between h-full">
            <div>
              <div class="flex items-center justify-between pb-3 border-b border-white/5">
                <h3 class="text-sm font-bold text-white flex items-center gap-2">
                  <i data-lucide="radio" class="w-4 h-4 text-[#E5A93C]"></i> Live Telemetry Feed
                </h3>
                <span class="text-[10px] font-mono text-slate-500">Live Socket</span>
              </div>
              <div class="mt-4 space-y-3 text-xs">
                <div class="p-3 rounded-xl bg-white/[0.02] border border-white/5">
                  <div class="flex items-center justify-between text-[10px] font-mono">
                    <span class="text-[#E5A93C] font-semibold">PLOT K-018 // POUR #4</span>
                    <span class="text-slate-500">07:18 CET</span>
                  </div>
                  <p class="text-slate-200 mt-1 font-medium">Batch C30/37 (42m³) Foundation Slab Certified</p>
                  <p class="text-[10px] text-slate-400 mt-0.5">Slump: 180mm • 28-day cylinder strength: 38.4 MPa</p>
                </div>
                <div class="p-3 rounded-xl bg-white/[0.02] border border-white/5">
                  <div class="flex items-center justify-between text-[10px] font-mono">
                    <span class="text-emerald-400 font-semibold">SUPPLY CHAIN // BORDER CLEARANCE</span>
                    <span class="text-slate-500">06:40 CET</span>
                  </div>
                  <p class="text-slate-200 mt-1 font-medium">Schüco AWS 75.SI+ Glazing Convoy Arrived</p>
                  <p class="text-[10px] text-slate-400 mt-0.5">32 crates cleared at Gradina border • Staged in Depot 2</p>
                </div>
              </div>
            </div>
            <button onclick="inspectPlotDetails('K-018')" class="w-full py-2 px-3 rounded-xl bg-white/5 hover:bg-white/10 text-xs font-mono text-slate-300 text-center transition flex items-center justify-center gap-2">
              <i data-lucide="eye" class="w-3.5 h-3.5 text-[#E5A93C]"></i> Deep Inspect Plot K-018
            </button>
          </div>
        </div>
      </div>
    </main>

    <!-- PILLAR 2: 120-PLOT CAD MATRIX -->
    <section id="view-matrix" class="tab-view hidden space-y-6">
      <div class="double-bezel">
        <div class="inner-core p-6 space-y-5">
          <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-4 border-b border-white/5">
            <div>
              <span class="text-xs font-mono text-[#E5A93C] uppercase tracking-wider">SINTEZA CAD 120-PLOT SCHEME</span>
              <h2 class="text-xl font-bold text-white tracking-tight mt-1">Interactive 120-Plot Micro-Telemetry Matrix (K1 - K120)</h2>
            </div>
            <div class="flex flex-wrap items-center gap-2 text-xs font-mono">
              <button onclick="filterPlots('all')" class="filter-chip px-3 py-1.5 rounded-full bg-white/10 text-white font-semibold">All (120)</button>
              <button onclick="filterPlots('fitout')" class="filter-chip px-3 py-1.5 rounded-full bg-white/5 text-emerald-400 hover:bg-emerald-500/10">Fitout (20)</button>
              <button onclick="filterPlots('mep')" class="filter-chip px-3 py-1.5 rounded-full bg-white/5 text-cyan-400 hover:bg-cyan-500/10">MEP (25)</button>
              <button onclick="filterPlots('structure')" class="filter-chip px-3 py-1.5 rounded-full bg-white/5 text-blue-400 hover:bg-blue-500/10">Structure (31)</button>
              <button onclick="filterPlots('foundation')" class="filter-chip px-3 py-1.5 rounded-full bg-white/5 text-amber-400 hover:bg-amber-500/10">Foundation (22)</button>
              <button onclick="filterPlots('earthworks')" class="filter-chip px-3 py-1.5 rounded-full bg-white/5 text-rose-400 hover:bg-rose-500/10">Earthworks (14)</button>
            </div>
          </div>
          <div id="plots-container" class="grid grid-cols-4 sm:grid-cols-6 md:grid-cols-10 lg:grid-cols-12 gap-2.5 pt-2 max-h-[580px] overflow-y-auto pr-1"></div>
        </div>
      </div>
    </section>

    <!-- PILLAR 3: 3D BIM & DRONE LIDAR -->
    <section id="view-digital-twin" class="tab-view hidden space-y-6">
      <div class="double-bezel">
        <div class="inner-core p-6 space-y-6">
          <div class="flex justify-between items-center pb-4 border-b border-white/5">
            <div>
              <span class="text-xs font-mono text-[#E5A93C] uppercase tracking-wider">NATIVE BROWSER IFC & POINT-CLOUD ENGINE</span>
              <h2 class="text-xl font-bold text-white tracking-tight mt-1">Autonomous Drone LiDAR Volumetric Diff & CAD Overlay</h2>
            </div>
            <span class="px-3 py-1 rounded-full bg-cyan-500/10 text-cyan-400 border border-cyan-500/20 text-xs font-mono">LiDAR Accuracy: ±2.8 mm</span>
          </div>
          <div class="relative w-full h-[460px] rounded-2xl overflow-hidden border border-white/10 bg-[#050608] flex items-center justify-center">
            <canvas id="bim-canvas" width="800" height="460" class="w-full h-full"></canvas>
          </div>
        </div>
      </div>
    </section>

    <!-- PILLAR 4: FIDIC ESCROW MULTI-SIG -->
    <section id="view-escrow" class="tab-view hidden space-y-6">
      <div class="double-bezel">
        <div class="inner-core p-6 space-y-6">
          <div class="flex justify-between items-center pb-4 border-b border-white/5">
            <div>
              <span class="text-xs font-mono text-[#E5A93C] uppercase tracking-wider">FIDIC RED BOOK ESCROW PROTOCOL</span>
              <h2 class="text-xl font-bold text-white tracking-tight mt-1">Multi-Party Cryptographic Milestone Release</h2>
            </div>
            <span class="text-slate-400 text-xs font-mono">Locked: <strong class="text-emerald-400 font-bold" id="escrow-locked-val">€17,130,000</strong></span>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
            <div class="p-4 rounded-2xl bg-white/[0.02] border border-white/5">
              <span class="text-slate-400 font-mono text-xs">Developer</span>
              <div class="text-sm font-bold text-white mt-1">ILB Development Ltd</div>
              <span class="text-emerald-400 font-mono text-[10px]">SIGNED</span>
            </div>
            <div class="p-4 rounded-2xl bg-white/[0.02] border border-white/5">
              <span class="text-slate-400 font-mono text-xs">Independent Engineer</span>
              <div class="text-sm font-bold text-white mt-1">Sinteza CAD Lab</div>
              <span class="text-emerald-400 font-mono text-[10px]">CERTIFIED</span>
            </div>
            <div class="p-4 rounded-2xl bg-white/[0.02] border border-white/5">
              <span class="text-slate-400 font-mono text-xs">Bank Escrow Trustee</span>
              <div class="text-sm font-bold text-white mt-1">UniCredit Bank Custody</div>
              <span class="text-emerald-400 font-mono text-[10px]">CONFIRMED</span>
            </div>
            <div class="p-4 rounded-2xl bg-white/[0.02] border border-amber-500/20">
